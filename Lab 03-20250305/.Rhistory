compound_interest <- function(P, r, n) {
P * (1 + r)^n
}
P <- 5000
r <- 11.5 / 100
for (n in 1:15) {
A <- compound_interest(P, r, n)
cat("Year", n, ": Amount =", round(A, 2), "\n")
