# Logical Operators
x <- 5
y <- 4
# Greater than
print(paste("x > y:", x > y))       # TRUE
# Equal to
print(paste("x == y:", x == y))     # FALSE
# Not equal to
print(paste("x != y:", x != y))     # TRUE
# Less than or equal
print(paste("x <= y:", x <= y))     # FALSE
# AND operator (element-wise)
print(paste("x > 0 & y > 0:", x > 0 & y > 0))   # TRUE
# OR operator (element-wise)
print(paste("x > 10 | y > 3:", x > 10 | y > 3)) # TRUE
# NOT operator
print(paste("!(x == y):", !(x == y)))          # TRUE
